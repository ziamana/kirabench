[{"t0": 8.44, "t1": 375.65, "kind": "thinking", "text": "The user wants me to create a fun 2D physics animation with:\n1. A canvas-based animation\n2. A car driving from left to right\n3. A brick wall with at least 40 bricks\n4. On impact: bricks fly with gravity, bounce, pile up\n5. Car damage: front crumples, parts break off, sparks/smoke\n6. Counter \"Bricks knocked: N\"\n7. Replay button\n8. Auto-starts on page open\n9. No external resources\n\nLet me create a single index.html file with embedded CSS and JavaScript that handles all of this. I'll need to implement:\n- A simple 2D physics engine (gravity, collision, bouncing)\n- Car rendering and animation\n- Brick wall rendering\n- Collision detection between car and bricks\n- Particle effects for sparks/smoke\n- UI elements (counter, replay button)\n\nLet me write this as a comprehensive single HTML file.\n"}, {"t0": 17.35, "t1": 375.66, "kind": "tool", "tool": "write", "args": {"path": "index.html", "content": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Car Crash Physics</title>\n<style>\n* { margin: 0; padding: 0; box-sizing: border-box; }\nbody {\n  background: #1a1a2e;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  overflow: hidden;\n}\ncanvas {\n  border-radius: 8px;\n  box-shadow: 0 0 30px rgba(0,0,0,0.5);\n}\n#ui {\n  position: absolute;\n  top: 20px;\n  left: 50%;\n  transform: translateX(-50%);\n  display: flex;\n  gap: 20px;\n  align-items: center;\n  z-index: 10;\n}\n#counter {\n  color: #fff;\n  font-size: 22px;\n  font-weight: bold;\n  background: rgba(0,0,0,0.6);\n  padding: 8px 20px;\n  border-radius: 20px;\n  border: 2px solid #e94560;\n}\n#replay {\n  color: #fff;\n  font-size: 18px;\n  font-weight: bold;\n  background: #e94560;\n  border: none;\n  padding: 10px 24px;\n  border-radius: 20px;\n  cursor: pointer;\n  transition: background 0.2s, transform 0.1s;\n}\n#replay:hover { background: #c73650; transform: scale(1.05); }\n#replay:active { transform: scale(0.95); }\n</style>\n</head>\n<body>\n<div id=\"ui\">\n  <div id=\"counter\">Bricks knocked: 0</div>\n  <button id=\"replay\">Replay</button>\n</div>\n<canvas id=\"canvas\"></canvas>\n<script>\nconst canvas = document.getElementById('canvas');\nconst ctx = canvas.getContext('2d');\nconst counterEl = document.getElementById('counter');\nconst replayBtn = document.getElementById('replay');\n\nconst W = 900, H = 500;\ncanvas.width = W;\ncanvas.height = H;\n\nconst GROUND_Y = H - 50;\nconst GRAVITY = 0.45;\nconst FRICTION = 0.98;\nconst BOUNCE = 0.55;\n\nlet bricks = [];\nlet particles = [];\nlet smokeParticles = [];\nlet sparkParticles = [];\nlet debris = [];\nlet car = null;\nlet crashed = false;\nlet crashTime = 0;\nlet bricksKnocked = 0;\nlet animId = null;\nlet frameCount = 0;\n\n// --- Brick class ---\nclass Brick {\n  constructor(x, y, w, h) {\n    this.x = x; this.y = y;\n    this.w = w; this.h = h;\n    this.vx = 0; this.vy = 0;\n    this.rotation = 0;\n    this.angularVel = 0;\n    this.active = true;\n    this.onGround = false;\n    this.color = this.randomColor();\n    this.knocked = false;\n  }\n  randomColor() {\n    const colors = ['#b5453a','#c1440c','#a0522d','#8b4513','#cd853f','#d2691e','#a0522d','#b8533a','#c45a3a','#8b3a3a'];\n    return colors[Math.floor(Math.random() * colors.length)];\n  }\n  update() {\n    if (!this.active) return;\n    this.vy += GRAVITY;\n    this.vx *= FRICTION;\n    this.x += this.vx;\n    this.y += this.vy;\n    this.rotation += this.angularVel;\n    this.angularVel *= 0.99;\n    if (this.y + this.h > GROUND_Y) {\n      this.y = GROUND_Y - this.h;\n      this.vy *= -BOUNCE;\n      this.vx *= 0.9;\n      this.angularVel *= 0.8;\n      if (Math.abs(this.vy) < 1) { this.vy = 0; this.onGround = true; }\n    }\n    // walls\n    if (this.x < 0) { this.x = 0; this.vx *= -BOUNCE; }\n    if (this.x + this.w > W) { this.x = W - this.w; this.vx *= -BOUNCE; }\n    if (this.knocked && !this.knockedCounted) {\n      this.knockedCounted = true;\n      bricksKnocked++;\n      counterEl.textContent = 'Bricks knocked: ' + bricksKnocked;\n    }\n  }\n  draw() {\n    if (!this.active) return;\n    ctx.save();\n    ctx.translate(this.x + this.w/2, this.y + this.h/2);\n    ctx.rotate(this.rotation);\n    // brick body\n    ctx.fillStyle = this.color;\n    ctx.fillRect(-this.w/2, -this.h/2, this.w, this.h);\n    // brick lines\n    ctx.strokeStyle = 'rgba(0,0,0,0.3)';\n    ctx.lineWidth = 1;\n    ctx.strokeRect(-this.w/2, -this.h/2, this.w, this.h);\n    // horizontal mortar line\n    ctx.beginPath();\n    ctx.moveTo(-this.w/2, 0);\n    ctx.lineTo(this.w/2, 0);\n    ctx.stroke();\n    // vertical mortar line (offset)\n    ctx.beginPath();\n    ctx.moveTo(0, -this.h/2);\n    ctx.lineTo(0, 0);\n    ctx.stroke();\n    ctx.restore();\n  }\n  containsPoint(px, py) {\n    // simple AABB (ignoring rotation for collision)\n    return px >= this.x && px <= this.x + this.w && py >= this.y && py <= this.y + this.h;\n  }\n}\n\n// --- Particle classes ---\nclass Spark {\n  constructor(x, y) {\n    this.x = x; this.y = y;\n    const angle = Math.random() * Math.PI * 2;\n    const speed = 2 + Math.random() * 6;\n    this.vx = Math.cos(angle) * speed;\n    this.vy = Math.sin(angle) * speed - 2;\n    this.life = 1;\n    this.decay = 0.02 + Math.random() * 0.04;\n    this.size = 1 + Math.random() * 2;\n  }\n  update() {\n    this.vy += 0.15;\n    this.x += this.vx;\n    this.y += this.vy;\n    this.life -= this.decay;\n    if (this.y > GROUND_Y) { this.y = GROUND_Y; this.vy *= -0.3; this.vx *= 0.8; }\n  }\n  draw() {\n    if (this.life <= 0) return;\n    ctx.globalAlpha = this.life;\n    ctx.fillStyle = this.life > 0.5 ? '#ffff00' : '#ff8800';\n    ctx.fillRect(this.x, this.y, this.size, this.size);\n    ctx.globalAlpha = 1;\n  }\n}\n\nclass SmokeParticle {\n  constructor(x, y) {\n    this.x = x; this.y = y;\n    this.vx = -0.5 + Math.random() * 1.5;\n    this.vy = -1 - Math.random() * 2;\n    this.life = 1;\n    this.decay = 0.008 + Math.random() * 0.012;\n    this.size = 3 + Math.random() * 6;\n    this.maxSize = this.size + 10 + Math.random() * 15;\n  }\n  update() {\n    this.x += this.vx;\n    this.y += this.vy;\n    this.vy -= 0.02;\n    this.vx *= 0.99;\n    this.life -= this.decay;\n    this.size += (this.maxSize - this.size) * 0.03;\n  }\n  draw() {\n    if (this.life <= 0) return;\n    ctx.globalAlpha = this.life * 0.4;\n    ctx.fillStyle = '#888';\n    ctx.beginPath();\n    ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.globalAlpha = 1;\n  }\n}\n\nclass Debris {\n  constructor(x, y, type) {\n    this.x = x; this.y = y;\n    this.type = type; // 'wheel', 'headlight', 'mirror', 'panel'\n    this.vx = (Math.random() - 0.5) * 8;\n    this.vy = -2 - Math.random() * 5;\n    this.rotation = Math.random() * Math.PI * 2;\n    this.angularVel = (Math.random() - 0.5) * 0.3;\n    this.life = 1;\n    this.active = true;\n  }\n  update() {\n    this.vy += GRAVITY;\n    this.x += this.vx;\n    this.y += this.vy;\n    this.rotation += this.angularVel;\n    if (this.y + 10 > GROUND_Y) {\n      this.y = GROUND_Y - 10;\n      this.vy *= -BOUNCE * 0.5;\n      this.vx *= 0.7;\n      this.angularVel *= 0.7;\n      if (Math.abs(this.vy) < 0.5) this.vy = 0;\n    }\n    if (this.x < -50 || this.x > W + 50) this.active = false;\n  }\n  draw() {\n    if (!this.active) return;\n    ctx.save();\n    ctx.translate(this.x, this.y);\n    ctx.rotate(this.rotation);\n    if (this.type === 'wheel') {\n      ctx.fillStyle = '#333';\n      ctx.beginPath();\n      ctx.arc(0, 0, 8, 0, Math.PI * 2);\n      ctx.fill();\n      ctx.fillStyle = '#666';\n      ctx.beginPath();\n      ctx.arc(0, 0, 4, 0, Math.PI * 2);\n      ctx.fill();\n    } else if (this.type === 'headlight') {\n      ctx.fillStyle = '#ffff88';\n      ctx.fillRect(-4, -4, 8, 8);\n      ctx.strokeStyle = '#aaa';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(-4, -4, 8, 8);\n    } else if (this.type === 'mirror') {\n      ctx.fillStyle = '#cc3333';\n      ctx.fillRect(-3, -5, 6, 10);\n    } else {\n      ctx.fillStyle = '#aa2222';\n      ctx.fillRect(-6, -4, 12, 8);\n    }\n    ctx.restore();\n  }\n}\n\n// --- Car ---\nfunction createCar() {\n  return {\n    x: -80,\n    y: GROUND_Y - 45,\n    w: 110,\n    h: 45,\n    speed: 5,\n    crumpleAmount: 0,\n    crumpleDir: 1,\n    wheelAngle: 0,\n    // Original front X for crumple reference\n    frontX: 0,\n    // Damage state\n    headlightBroken: false,\n    hoodUp: false,\n    hoodAngle: 0,\n    smokeTimer: 0,\n    sparkTimer: 0,\n  };\n}\n\nfunction drawCar(c) {\n  const cx = c.x;\n  const cy = c.y;\n  const cw = c.w;\n  const ch = c.h;\n  const frontX = cx + cw;\n  const crumple = c.crumpleAmount;\n\n  // --- Car body ---\n  // Main body (rear section, not damaged)\n  ctx.fillStyle = '#d43333';\n  ctx.beginPath();\n  ctx.moveTo(cx, cy + ch);\n  ctx.lineTo(cx, cy + 12);\n  ctx.lineTo(cx + 15, cy + 5);\n  ctx.lineTo(cx + cw - crumple * 15, cy + 5);\n  ctx.lineTo(cx + cw - crumple * 15, cy + ch);\n  ctx.closePath();\n  ctx.fill();\n  ctx.strokeStyle = '#8b1a1a';\n  ctx.lineWidth = 1;\n  ctx.stroke();\n\n  // Cabin / roof\n  ctx.fillStyle = '#cc2222';\n  ctx.beginPath();\n  ctx.moveTo(cx + 20, cy + 5);\n  ctx.lineTo(cx + 30, cy - 10);\n  ctx.lineTo(cx + 65, cy - 10);\n  ctx.lineTo(cx + 75, cy + 5);\n  ctx.closePath();\n  ctx.fill();\n  ctx.stroke();\n\n  // Windows\n  ctx.fillStyle = '#88bbdd';\n  ctx.beginPath();\n  ctx.moveTo(cx + 32, cy - 7);\n  ctx.lineTo(cx + 38, cy - 7);\n  ctx.lineTo(cx + 42, cy + 2);\n  ctx.lineTo(cx + 28, cy + 2);\n  ctx.closePath();\n  ctx.fill();\n\n  ctx.beginPath();\n  ctx.moveTo(cx + 48, cy - 7);\n  ctx.lineTo(cx + 62, cy - 7);\n  ctx.lineTo(cx + 67, cy + 2);\n  ctx.lineTo(cx + 44, cy + 2);\n  ctx.closePath();\n  ctx.fill();\n\n  // Hood (may be crumpled)\n  if (crumple > 0) {\n    ctx.fillStyle = '#bb2222';\n    ctx.beginPath();\n    ctx.moveTo(cx + cw - crumple * 15 - 20, cy + 5);\n    ctx.lineTo(cx + cw - crumple * 15, cy + 5);\n    ctx.lineTo(cx + cw - crumple * 5, cy + 5 + crumple * 12);\n    ctx.lineTo(cx + cw - crumple * 15 - 20, cy + 5);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n  } else {\n    ctx.fillStyle = '#cc3333';\n    ctx.fillRect(cx + cw - 25, cy + 2, 25, 8);\n  }\n\n  // Front bumper area (crushed)\n  if (crumple > 0) {\n    ctx.fillStyle = '#991111';\n    ctx.beginPath();\n    ctx.moveTo(frontX - crumple * 15, cy + 5);\n    ctx.lineTo(frontX - crumple * 15, cy + ch);\n    ctx.lineTo(frontX - crumple * 10, cy + ch);\n    ctx.lineTo(frontX - crumple * 5, cy + 10 + crumple * 8);\n    ctx.lineTo(frontX - crumple * 15, cy + 5);\n    ctx.closePath();\n    ctx.fill();\n    // Dent lines\n    ctx.strokeStyle = '#660000';\n    ctx.lineWidth = 1;\n    for (let i = 0; i < 3; i++) {\n      const dy = 8 + i * 8;\n      ctx.beginPath();\n      ctx.moveTo(frontX - crumple * 15, cy + dy);\n      ctx.lineTo(frontX - crumple * 15 + 5 + i * 3, cy + dy + 3);\n      ctx.stroke();\n    }\n  }\n\n  // Headlight\n  if (!c.headlightBroken) {\n    ctx.fillStyle = '#ffff66';\n    ctx.beginPath();\n    ctx.arc(frontX - 3, cy + 18, 5, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.strokeStyle = '#888';\n    ctx.lineWidth = 1;\n    ctx.stroke();\n  } else {\n    // Broken headlight\n    ctx.fillStyle = '#666';\n    ctx.beginPath();\n    ctx.arc(frontX - 3, cy + 18, 5, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.strokeStyle = '#333';\n    ctx.stroke();\n    // Crack lines\n    ctx.strokeStyle = '#aaa';\n    ctx.lineWidth = 0.5;\n    ctx.beginPath();\n    ctx.moveTo(frontX - 5, cy + 16);\n    ctx.lineTo(frontX - 1, cy + 20);\n    ctx.moveTo(frontX - 3, cy + 15);\n    ctx.lineTo(frontX + 1, cy + 17);\n    ctx.stroke();\n  }\n\n  // Tail light\n  ctx.fillStyle = '#ff3333';\n  ctx.fillRect(cx - 1, cy + 10, 4, 8);\n\n  // Side trim\n  ctx.fillStyle = '#888';\n  ctx.fillRect(cx + 10, cy + ch - 5, cw - 20, 3);\n\n  // Door handle\n  ctx.fillStyle = '#aaa';\n  ctx.fillRect(cx + 45, cy + 8, 8, 2);\n\n  // Side mirror\n  if (crumple < 0.3) {\n    ctx.fillStyle = '#cc2222';\n    ctx.fillRect(frontX - 8, cy - 2, 6, 8);\n    ctx.fillStyle = '#88bbdd';\n    ctx.fillRect(frontX - 7, cy, 4, 4);\n  }\n\n  // Wheels\n  c.wheelAngle += c.speed * 0.15;\n  drawWheel(cx + 22, cy + ch, 10, c.wheelAngle);\n  drawWheel(cx + cw - 18, cy + ch, 10, c.wheelAngle);\n}\n\nfunction drawWheel(x, y, r, angle) {\n  ctx.save();\n  ctx.translate(x, y);\n  ctx.rotate(angle);\n  // Tire\n  ctx.fillStyle = '#222';\n  ctx.beginPath();\n  ctx.arc(0, 0, r, 0, Math.PI * 2);\n  ctx.fill();\n  // Rim\n  ctx.fillStyle = '#777';\n  ctx.beginPath();\n  ctx.arc(0, 0, r * 0.55, 0, Math.PI * 2);\n  ctx.fill();\n  // Spokes\n  ctx.strokeStyle = '#555';\n  ctx.lineWidth = 2;\n  for (let i = 0; i < 5; i++) {\n    const a = (i / 5) * Math.PI * 2;\n    ctx.beginPath();\n    ctx.moveTo(0, 0);\n    ctx.lineTo(Math.cos(a) * r * 0.55, Math.sin(a) * r * 0.55);\n    ctx.stroke();\n  }\n  ctx.restore();\n}\n\n// --- Build wall ---\nfunction buildWall() {\n  const brickW = 36;\n  const brickH = 18;\n  const cols = 8;\n  const rows = 7;\n  const startX = W - 180;\n  const startY = GROUND_Y - brickH;\n  bricks = [];\n  for (let row = 0; row < rows; row++) {\n    for (let col = 0; col < cols; col++) {\n      const offset = (row % 2 === 1) ? brickW / 2 : 0;\n      const bx = startX + col * brickW + offset - (row % 2 === 1 ? brickW / 2 : 0);\n      const by = startY - row * brickH;\n      bricks.push(new Brick(bx, by, brickW - 2, brickH - 2));\n    }\n  }\n}\n\n// --- Particles ---\nfunction spawnSparks(x, y, count) {\n  for (let i = 0; i < count; i++) {\n    sparkParticles.push(new Spark(x, y));\n  }\n}\nfunction spawnSmoke(x, y) {\n  smokeParticles.push(new SmokeParticle(x, y));\n}\n\n// --- Collision ---\nfunction checkCarBrickCollision(c, brick) {\n  if (!brick.active || brick.knocked) return false;\n  const frontX = c.x + c.w - c.crumpleAmount * 15;\n  return frontX > brick.x && c.x < brick.x + brick.w &&\n         c.y + c.h > brick.y && c.y < brick.y + brick.h;\n}\n\n// --- Background ---\nfunction drawBackground() {\n  // Sky gradient\n  const skyGrad = ctx.createLinearGradient(0, 0, 0, GROUND_Y);\n  skyGrad.addColorStop(0, '#1a1a3e');\n  skyGrad.addColorStop(0.5, '#2d2d5e');\n  skyGrad.addColorStop(1, '#4a4a7a');\n  ctx.fillStyle = skyGrad;\n  ctx.fillRect(0, 0, W, GROUND_Y);\n\n  // Stars\n  ctx.fillStyle = '#fff';\n  for (let i = 0; i < 40; i++) {\n    const sx = (i * 137 + 50) % W;\n    const sy = (i * 73 + 20) % (GROUND_Y - 100);\n    const ss = 0.5 + (i % 3) * 0.5;\n    ctx.globalAlpha = 0.3 + (i % 5) * 0.15;\n    ctx.fillRect(sx, sy, ss, ss);\n  }\n  ctx.globalAlpha = 1;\n\n  // Moon\n  ctx.fillStyle = '#eee8cc';\n  ctx.beginPath();\n  ctx.arc(750, 60, 30, 0, Math.PI * 2);\n  ctx.fill();\n  ctx.fillStyle = '#1a1a3e';\n  ctx.beginPath();\n  ctx.arc(760, 55, 25, 0, Math.PI * 2);\n  ctx.fill();\n\n  // Ground\n  const groundGrad = ctx.createLinearGradient(0, GROUND_Y, 0, H);\n  groundGrad.addColorStop(0, '#4a4a4a');\n  groundGrad.addColorStop(1, '#2a2a2a');\n  ctx.fillStyle = groundGrad;\n  ctx.fillRect(0, GROUND_Y, W, H - GROUND_Y);\n\n  // Road markings\n  ctx.strokeStyle = '#666';\n  ctx.lineWidth = 2;\n  ctx.setLineDash([30, 20]);\n  ctx.beginPath();\n  ctx.moveTo(0, GROUND_Y + 25);\n  ctx.lineTo(W, GROUND_Y + 25);\n  ctx.stroke();\n  ctx.setLineDash([]);\n\n  // Sidewalk\n  ctx.fillStyle = '#555';\n  ctx.fillRect(0, GROUND_Y, W, 8);\n  ctx.strokeStyle = '#444';\n  ctx.lineWidth = 1;\n  for (let i = 0; i < W; i += 40) {\n    ctx.beginPath();\n    ctx.moveTo(i, GROUND_Y);\n    ctx.lineTo(i, GROUND_Y + 8);\n    ctx.stroke();\n  }\n\n  // Background buildings silhouette\n  ctx.fillStyle = '#1e1e3a';\n  // Building 1\n  ctx.fillRect(50, GROUND_Y - 120, 60, 120);\n  ctx.fillRect(120, GROUND_Y - 80, 40, 80);\n  // Building 2\n  ctx.fillRect(250, GROUND_Y - 150, 50, 150);\n  ctx.fillRect(310, GROUND_Y - 100, 35, 100);\n  // Building 3\n  ctx.fillRect(600, GROUND_Y - 130, 55, 130);\n  ctx.fillRect(670, GROUND_Y - 90, 45, 90);\n  ctx.fillRect(730, GROUND_Y - 160, 40, 160);\n\n  // Building windows\n  ctx.fillStyle = '#3a3a5a';\n  for (let bx = 55; bx < 105; bx += 15) {\n    for (let by = GROUND_Y - 110; by < GROUND_Y - 10; by += 20) {\n      ctx.fillRect(bx, by, 8, 10);\n    }\n  }\n  for (let bx = 255; bx < 295; bx += 15) {\n    for (let by = GROUND_Y - 140; by < GROUND_Y - 10; by += 20) {\n      ctx.fillRect(bx, by, 8, 10);\n    }\n  }\n  for (let bx = 605; bx < 650; bx += 15) {\n    for (let by = GROUND_Y - 120; by < GROUND_Y - 10; by += 20) {\n      ctx.fillRect(bx, by, 8, 10);\n    }\n  }\n  for (let bx = 735; bx < 765; bx += 15) {\n    for (let by = GROUND_Y - 150; by < GROUND_Y - 10; by += 20) {\n      ctx.fillRect(bx, by, 8, 10);\n    }\n  }\n}\n\n// --- Main loop ---\nfunction reset() {\n  bricksKnocked = 0;\n  counterEl.textContent = 'Bricks knocked: 0';\n  crashed = false;\n  crashTime = 0;\n  particles = [];\n  smokeParticles = [];\n  sparkParticles = [];\n  debris = [];\n  frameCount = 0;\n  car = createCar();\n  buildWall();\n}\n\nfunction update() {\n  frameCount++;\n\n  if (!crashed) {\n    // Car driving\n    car.x += car.speed;\n    car.frontX = car.x + car.w;\n\n    // Check collision with any brick\n    for (const brick of bricks) {\n      if (checkCarBrickCollision(car, brick)) {\n        crashed = true;\n        crashTime = frameCount;\n        break;\n      }\n    }\n  }\n\n  if (crashed) {\n    const elapsed = frameCount - crashTime;\n\n    // Car crumple animation\n    if (elapsed < 30) {\n      car.crumpleAmount = Math.min(1, elapsed / 30);\n      car.speed *= 0.85;\n      car.x += car.speed;\n\n      // Spawn sparks at impact point\n      if (elapsed < 20 && elapsed % 2 === 0) {\n        const impactX = car.x + car.w;\n        spawnSparks(impactX, car.y + 20, 5 + Math.floor(Math.random() * 5));\n      }\n\n      // Spawn smoke\n      if (elapsed > 5 && elapsed % 4 === 0) {\n        spawnSmoke(car.x + car.w - 10, car.y + 5);\n      }\n\n      // Break off parts\n      if (elapsed === 5) {\n        car.headlightBroken = true;\n        debris.push(new Debris(car.x + car.w - 5, car.y + 20, 'headlight'));\n      }\n      if (elapsed === 10) {\n        debris.push(new Debris(car.x + car.w - 10, car.y - 5, 'mirror'));\n      }\n      if (elapsed === 15) {\n        debris.push(new Debris(car.x + 20, car.y + car.h, 'wheel'));\n        debris.push(new Debris(car.x + car.w - 18, car.y + car.h, 'wheel'));\n      }\n      if (elapsed === 20) {\n        debris.push(new Debris(car.x + car.w - 30, car.y + 5, 'panel'));\n      }\n    } else {\n      car.crumpleAmount = 1;\n      car.speed = 0;\n    }\n\n    // Hit bricks\n    for (const brick of bricks) {\n      if (brick.active && !brick.knocked) {\n        const frontX = car.x + car.w - car.crumpleAmount * 15;\n        if (frontX > brick.x - 10 && frontX < brick.x + brick.w + 5) {\n          // Check vertical overlap\n          if (car.y + car.h > brick.y + 2 && car.y < brick.y + brick.h - 2) {\n            brick.knocked = true;\n            // Random velocity based on position\n            const row = Math.floor((GROUND_Y - brick.y) / 20);\n            const col = Math.floor((brick.x - (W - 180)) / 36);\n            brick.vx = 2 + Math.random() * 4 + col * 0.5;\n            brick.vy = -3 - Math.random() * 5 - row * 0.3;\n            brick.angularVel = (Math.random() - 0.5) * 0.2;\n            // Some bricks get pushed further\n            if (Math.random() < 0.3) {\n              brick.vx *= 2;\n              brick.vy *= 1.5;\n              brick.angularVel *= 2;\n            }\n          }\n        }\n      }\n    }\n\n    // Extra sparks after crash\n    if (crashed && frameCount % 6 === 0 && frameCount - crashTime < 80) {\n      spawnSparks(car.x + car.w - 15, car.y + car.h / 2, 2);\n    }\n\n    // Extra smoke\n    if (crashed && frameCount % 8 === 0 && frameCount - crashTime < 120) {\n      spawnSmoke(car.x + car.w - 20 + Math.random() * 10, car.y - 5 + Math.random() * 10);\n    }\n  }\n\n  // Update bricks\n  for (const brick of bricks) {\n    brick.update();\n  }\n\n  // Brick-to-brick collisions (simplified)\n  for (let i = 0; i < bricks.length; i++) {\n    for (let j = i + 1; j < bricks.length; j++) {\n      const a = bricks[i], b = bricks[j];\n      if (!a.active || !b.active) continue;\n      if (a.x < b.x + b.w && a.x + a.w > b.x && a.y < b.y + b.h && a.y + a.h > b.y) {\n        // Simple push apart\n        const overlapX = Math.min(a.x + a.w - b.x, b.x + b.w - a.x);\n        const overlapY = Math.min(a.y + a.h - b.y, b.y + b.h - a.y);\n        if (overlapX < overlapY) {\n          const push = overlapX / 2;\n          if (a.x < b.x) { a.x -= push; b.x += push; }\n          else { a.x += push; b.x -= push; }\n          // Transfer some velocity\n          const avgVx = (a.vx + b.vx) / 2;\n          a.vx = avgVx + (a.vx - b.vx) * 0.3;\n          b.vx = avgVx - (a.vx - b.vx) * 0.3;\n        } else {\n          const push = overlapY / 2;\n          if (a.y < b.y) { a.y -= push; b.y += push; }\n          else { a.y += push; b.y -= push; }\n          const avgVy = (a.vy + b.vy) / 2;\n          a.vy = avgVy + (a.vy - b.vy) * 0.3;\n          b.vy = avgVy - (a.vy - b.vy) * 0.3;\n        }\n      }\n    }\n  }\n\n  // Update particles\n  sparkParticles.forEach(p => p.update());\n  smokeParticles.forEach(p => p.update());\n  debris.forEach(p => p.update());\n\n  // Cleanup\n  sparkParticles = sparkParticles.filter(p => p.life > 0);\n  smokeParticles = smokeParticles.filter(p => p.life > 0);\n  debris = debris.filter(p => p.active);\n}\n\nfunction draw() {\n  ctx.clearRect(0, 0, W, H);\n  drawBackground();\n\n  // Draw debris (under bricks)\n  debris.forEach(d 